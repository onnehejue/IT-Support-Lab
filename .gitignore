# Keep local secrets, VM files and raw/unreviewed screenshots out of the portfolio.
.env
.env.*
*.key
*.pem
*.vdi
*.vmdk
*.vhd
*.vhdx
*.ova
*.iso
*.png
*.jpg
*.jpeg
*.webp
*.zip
Thumbs.db
.DS_Store

# Allow only the selected evidence in task screenshot folders.
!Active-Directory/screenshots/*.png
!Windows-11-Support/screenshots/*.png
!Networking-DNS/screenshots/*.png
!Microsoft-365-Entra/screenshots/*.png
